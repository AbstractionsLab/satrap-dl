// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/docker-existing-dockerfile
{
	"name": "satrap-dev",
	"build": {
		// Sets the run context to one level up instead of the .devcontainer folder.
		"context": "..",
		// Update the 'dockerFile' property if you aren't using the standard 'Dockerfile' filename.
		"dockerfile": "../Dockerfile.dev"
		// NOTE: with the option below, VS Code creates two images with the same id but with different tags;
		// one has the tag given below, the other one has a tag randomly assigned by VS Code.
		// VS Code uses the latter, but it might be useful to specify a custom tag for easier
		// reference outside of VS Code.
		// "options": ["--tag", "satrap-dev:0.1"]
	},

	// Fixed container path, independent of the name of the local clone folder;
	// the image expects the workspace here (see Dockerfile.dev).
	"workspaceFolder": "/workspaces/cti-analysis-platform",
	"workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/cti-analysis-platform,type=bind",

	"remoteUser": "alab",

	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Prevent VS Code from auto-forwarding port 7006 used by Flowintel as it might already be
	// exposed on the host. Auto-forwarding it from the dev container would cause conflicts.
	"portsAttributes": {
		"7006": { "onAutoForward": "ignore" }
	},

	// Editable install of the root packages from the bind mount. --only-root
	// activates no dependency groups, so it stays offline, runs in about a
	// second, and cannot drift from the group list baked into the image.
	"postCreateCommand": "poetry install --only-root --no-ansi",

	// import satrap and import decipher work even if postCreateCommand is skipped.
	"containerEnv": {
		"PYTHONPATH": "/workspaces/cti-analysis-platform"
	},

	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
            "extensions": [
				"ms-python.python",
				"ms-python.black-formatter",
				"ms-toolsai.jupyter",
				"streetsidesoftware.code-spell-checker",
				"typedb.typeql"
			],
            "settings": {
				"python.defaultInterpreterPath": "/home/alab/.venv/bin/python",
				"cSpell.enabled": true,
				"cSpell.words": [
					"STIX",
					"typedb",
					"defanged"
				]
            }
        }
	},

	"runArgs": ["--network", "satrap-net"]
}
